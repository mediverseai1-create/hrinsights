# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — powers Documents, Recruiting AI review, and the HR Assistant.
# Leave blank to keep those features in "Coming soon" mode. Only the server
# ever reads this key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Selar checkout links for paid plans (Settings → Pricing on your Selar
# dashboard). Buttons show "not configured yet" until these are set.
STARTER_PAYMENT_LINK=
PRO_PAYMENT_LINK=
